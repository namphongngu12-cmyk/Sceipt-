	Label.BackgroundTransparency = 1
	Label.Text = Text
	Label.TextColor3 = Color3.new(1, 1, 1)
	Label.TextSize = 14
	Label.Font = Enum.Font.Gotham
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Row

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.fromOffset(52, 28)
	Button.Position = UDim2.new(1, -52, 0.5, -14)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.Parent = Row
	Corner(Button, 20)

	local Knob = Instance.new("Frame")
	Knob.Size = UDim2.fromOffset(22, 22)
	Knob.Parent = Button
	Corner(Knob, 20)

	local Value = Default

	local function Render()
		Button.BackgroundColor3 = Value
			and Color3.fromRGB(70, 190, 110)
			or Color3.fromRGB(65, 65, 78)

		Knob.Position = Value
			and UDim2.new(1, -24, 0, 3)
			or UDim2.fromOffset(2, 3)
	end

	Render()

	Button.Activated:Connect(function()
		Value = not Value
		Render()

		if Callback then
			Callback(Value)
		end
	end)

	return {
		Get = function()
			return Value
		end,

		Set = function(NewValue)
			Value = NewValue == true
			Render()

			if Callback then
				Callback(Value)
			end
		end
	}
end

