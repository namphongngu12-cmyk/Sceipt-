	Minus.TextColor3 = Color3.new(1, 1, 1)
	Minus.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
	Minus.Parent = Container
	Corner(Minus, 8)

	local Bar = Instance.new("Frame")
	Bar.Size = UDim2.new(1, -150, 0, 10)
	Bar.Position = UDim2.fromOffset(36, 34)
	Bar.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
	Bar.Parent = Container
	Corner(Bar, 10)

	local Fill = Instance.new("Frame")
	Fill.BackgroundColor3 = Color3.fromRGB(80, 110, 220)
	Fill.Size = UDim2.fromScale(0, 1)
	Fill.Parent = Bar
	Corner(Fill, 10)

	local Plus = Instance.new("TextButton")
	Plus.Size = UDim2.fromOffset(28, 28)
	Plus.Position = UDim2.new(1, -100, 0, 25)
	Plus.Text = "+"
	Plus.TextSize = 18
	Plus.Font = Enum.Font.GothamBold
	Plus.TextColor3 = Color3.new(1, 1, 1)
	Plus.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
	Plus.Parent = Container
	Corner(Plus, 8)

	local Input = Instance.new("TextBox")
	Input.Size = UDim2.fromOffset(62, 28)
	Input.Position = UDim2.new(1, -65, 0, 25)
	Input.TextColor3 = Color3.new(1, 1, 1)
	Input.BackgroundColor3 = Color3.fromRGB(65, 65, 78)
	Input.Font = Enum.Font.Gotham
	Input.TextSize = 12
	Input.ClearTextOnFocus = false
	Input.Parent = Container
	Corner(Input, 8)

	local Value = math.clamp(Default, Min, Max)
	local DraggingSlider = false
	local Step = math.max((Max - Min) / 50, 0.1)

	local function SetValue(NewValue)
		Value = math.clamp(tonumber(NewValue) or Value, Min, Max)

		local Percent = (Value - Min) / (Max - Min)

		Fill.Size = UDim2.fromScale(Percent, 1)
		Input.Text = tostring(math.floor(Value * 100) / 100)

		if Callback then
			Callback(Value)
		end
	end

	local function Update(Position)
		if Bar.AbsoluteSize.X <= 0 then
			return
		end

		local Percent = math.clamp(
			(Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
			0,
			1
		)

		SetValue(Min + (Max - Min) * Percent)
	end

	SetValue(Value)

	Minus.Activated:Connect(function()
		SetValue(Value - Step)
	end)

	Plus.Activated:Connect(function()
		SetValue(Value + Step)
	end)

	Input.FocusLost:Connect(function()
		local Number = tonumber(Input.Text)

		if Number then
			SetValue(Number)
		else
			SetValue(Value)
		end
	end)

	Bar.InputBegan:Connect(function(InputObject)
		if InputObject.UserInputType == Enum.UserInputType.Touch
			or InputObject.UserInputType == Enum.UserInputType.MouseButton1 then

			DraggingSlider = true
			Update(InputObject.Position)
		end
	end)

	Connect(
		"SliderMove_" .. Id,
		UserInputService.InputChanged,
		function(InputObject)
			if not DraggingSlider then
				return
			end

			if InputObject.UserInputType == Enum.UserInputType.Touch
				or InputObject.UserInputType == Enum.UserInputType.MouseMovement then

				Update(InputObject.Position)
			end
		end
	)

	Connect(
		"SliderEnd_" .. Id,
		UserInputService.InputEnded,
		function(InputObject)
			if InputObject.UserInputType == Enum.UserInputType.Touch
				or InputObject.UserInputType == Enum.UserInputType.MouseButton1 then

				DraggingSlider = false
			end
		end
	)

	return {
		Get = function()
			return Value
		end,

		Set = SetValue
	}
end

