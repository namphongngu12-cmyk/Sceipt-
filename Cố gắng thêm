local FlySwitch = CreateSwitch(
	Movement,
	"Fly",
	false,
	function(Enabled)
		State.Fly = Enabled
		FlyButtons.Visible = Enabled

		Disconnect("Fly")

		if not Enabled then
			if Root then
				Root.AssemblyLinearVelocity = Vector3.zero
			end
			return
		end

		Connect("Fly", RunService.RenderStepped, function()
			if not Character or not Humanoid or not Root then
				return
			end

			local Camera = workspace.CurrentCamera
			if not Camera then
				return
			end

			local Move = Humanoid.MoveDirection
			local Vertical = 0

			if FlyUp then
				Vertical += 1
			end

			if FlyDown then
				Vertical -= 1
			end

			local Speed = FlySpeed.Get()

			Root.AssemblyLinearVelocity =
				Move * Speed +
				Vector3.new(0, Vertical * Speed, 0)
		end)
	end
)

