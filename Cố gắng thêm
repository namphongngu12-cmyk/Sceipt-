local function CreateSwitch(Parent, Text, Default, Callback)
	local Row = Instance.new("Frame")
	Row.Size = UDim2.new(1, 0, 0, 42)
	Row.BackgroundTransparency = 1
	Row.Parent = Parent

	local Label = Instance.new("TextLabel")
