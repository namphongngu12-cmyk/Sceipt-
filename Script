local function Slider(Pg,n,v,min,max,fn)
	local Fm=Instance.new("Frame")
	Fm.Size=UDim2.new(1,-5,0,55)
	Fm.BackgroundColor3=Color3.fromRGB(25,28,33)
	Fm.Parent=Pg
	Instance.new("UICorner",Fm).CornerRadius=UDim.new(0,8)

	local Lb=Instance.new("TextLabel")
	Lb.Size=UDim2.new(1,-24,0,22)
	Lb.Position=UDim2.fromOffset(12,4)
	Lb.BackgroundTransparency=1
	Lb.Text=n.."  "..v
	Lb.TextColor3=Color3.new(1,1,1)
	Lb.Font=Enum.Font.Gotham
	Lb.TextSize=12
	Lb.TextXAlignment=Enum.TextXAlignment.Left
	Lb.Parent=Fm

	local Bg=Instance.new("Frame")
	Bg.Size=UDim2.new(1,-24,0,6)
	Bg.Position=UDim2.fromOffset(12,36)
	Bg.BackgroundColor3=Color3.fromRGB(50,55,60)
	Bg.Parent=Fm
	Instance.new("UICorner",Bg).CornerRadius=UDim.new(1,0)

	local Fill=Instance.new("Frame")
	Fill.Size=UDim2.fromScale((v-min)/(max-min),1)
	Fill.BackgroundColor3=Color3.fromRGB(0,255,120)
	Fill.Parent=Bg
	Instance.new("UICorner",Fill).CornerRadius=UDim.new(1,0)

	local Knob=Instance.new("Frame")
	Knob.Size=UDim2.fromOffset(14,14)
	Knob.AnchorPoint=Vector2.new(.5,.5)
	Knob.Position=UDim2.fromScale((v-min)/(max-min),.5)
	Knob.BackgroundColor3=Color3.fromRGB(235,235,235)
	Knob.Parent=Bg
	Instance.new("UICorner",Knob).CornerRadius=UDim.new(1,0)

	local Drag=false

	local function Set(x)
		local r=math.clamp((x-Bg.AbsolutePosition.X)/Bg.AbsoluteSize.X,0,1)
		local value=math.floor(min+(max-min)*r)
		Fill.Size=UDim2.fromScale(r,1)
		Knob.Position=UDim2.fromScale(r,.5)
		Lb.Text=n.."  "..value
		fn(value)
	end

	Bg.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
			Drag=true
			Set(i.Position.X)
		end
	end)

	U.InputChanged:Connect(function(i)
		if Drag and (i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement) then
			Set(i.Position.X)
		end
	end)

	U.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then
			Drag=false
		end
	end)
end

