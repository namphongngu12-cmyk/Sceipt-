local function Tab(n)
	local B=Instance.new("TextButton")
	B.Size=UDim2.fromOffset(76,34)
	B.Text=n
	B.Font=Enum.Font.GothamSemibold
	B.TextSize=11
	B.TextColor3=Color3.fromRGB(210,210,210)
	B.BackgroundColor3=Color3.fromRGB(27,30,35)
	B.Parent=Bar
	Instance.new("UICorner",B).CornerRadius=UDim.new(0,7)

	local Pg=Instance.new("ScrollingFrame")
	Pg.Size=UDim2.fromScale(1,1)
	Pg.BackgroundTransparency=1
	Pg.BorderSizePixel=0
	Pg.ScrollBarThickness=3
	Pg.Visible=false
	Pg.AutomaticCanvasSize=Enum.AutomaticSize.Y
	Pg.Parent=Content

	local UL=Instance.new("UIListLayout")
	UL.Padding=UDim.new(0,7)
	UL.Parent=Pg

	Tabs[n]={B=B,P=Pg}

	B.Activated:Connect(function()
		for _,v in pairs(Tabs) do
			v.P.Visible=false
			v.B.BackgroundColor3=Color3.fromRGB(27,30,35)
		end
		Pg.Visible=true
		B.BackgroundColor3=Color3.fromRGB(0,110,55)
	end)

	return Pg
end

