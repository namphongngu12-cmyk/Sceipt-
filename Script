local Char,Hum,Root

local function Character(c)
	Char=c
	Hum=c:WaitForChild("Humanoid")
	Root=c:WaitForChild("HumanoidRootPart")
end

if LP.Character then Character(LP.Character) end
LP.CharacterAdded:Connect(Character)

local function GetAimTarget()
	local Camera=workspace.CurrentCamera
	local Center=Camera.ViewportSize/2
	local Best
	local BestScreen=math.huge

	for _,Player in ipairs(P:GetPlayers()) do
		if Player~=LP and Player.Character then
			local H=Player.Character:FindFirstChildOfClass("Humanoid")
			local Head=Player.Character:FindFirstChild("Head")
			local RP=Player.Character:FindFirstChild("HumanoidRootPart")

			if H and H.Health>0 and Head and RP then
				local Distance=(RP.Position-Camera.CFrame.Position).Magnitude

				if Distance<=C.Distance then
					local Screen,Visible=Camera:WorldToViewportPoint(Head.Position)

					if Visible then
						local SD=(Vector2.new(Screen.X,Screen.Y)-Center).Magnitude

						if SD<=C.FOV and SD<BestScreen then
							BestScreen=SD
							Best=Head
						end
					end
				end
			end
		end
	end

	return Best
end

local function AimAt(Target)
	if not Target then return end
	local Camera=workspace.CurrentCamera
	local Pos=Camera.CFrame.Position
	local Goal=CFrame.lookAt(Pos,Target.Position)
	Camera.CFrame=Camera.CFrame:Lerp(Goal,.18)
end

R.RenderStepped:Connect(function()
	if not Hum or not Root then return end

	if S.WalkSpeed then
		Hum.WalkSpeed=C.WalkSpeed
	end

	if S.HighJump then
		Hum.UseJumpPower=true
		Hum.JumpPower=C.JumpPower
	end

	if S.NoClip and Char then
		for _,Part in ipairs(Char:GetDescendants()) do
			if Part:IsA("BasePart") then
				Part.CanCollide=false
			end
		end
	end

	if S.Fly then
		local Dir=Vector3.zero
		local Cam=workspace.CurrentCamera

		if U:IsKeyDown(Enum.KeyCode.W) then Dir+=Cam.CFrame.LookVector end
		if U:IsKeyDown(Enum.KeyCode.S) then Dir-=Cam.CFrame.LookVector end
		if U:IsKeyDown(Enum.KeyCode.A) then Dir-=Cam.CFrame.RightVector end
		if U:IsKeyDown(Enum.KeyCode.D) then Dir+=Cam.CFrame.RightVector end

		Root.AssemblyLinearVelocity=Dir.Magnitude>0 and Dir.Unit*C.FlySpeed or Vector3.zero
	end

	if S.Aim then
		AimAt(GetAimTarget())
	end
end)

local ESPObjects={}

local function ClearESP()
	for _,v in pairs(ESPObjects) do
		if v then v:Destroy() end
	end
	table.clear(ESPObjects)
end

local function ESP(Player)
	if Player==LP or not S.ESP or not Player.Character then return end

	local H=Instance.new("Highlight")
	H.Adornee=Player.Character
	H.FillTransparency=.75
	H.OutlineTransparency=.15
	H.DepthMode=S.Wall and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
	H.Parent=Player.Character
	ESPObjects[Player]=H
end

P.PlayerAdded:Connect(function(Player)
	Player.CharacterAdded:Connect(function()
		task.wait(.5)
		ESP(Player)
	end)
end)

